# Copy to .env.local and adjust. Every value here has a working default —
# the game runs without a .env.local at all (just without persistence).

# ─── Database (optional) ─────────────────────────────────────────────────────
# The game is fully playable without MySQL: rooms live in memory and the
# leaderboard simply reports itself as unavailable.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ludo_game

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# The stable name other devices can use instead of a raw LAN IP, e.g.
# http://ludo.local:4000 — it keeps resolving to whatever this machine's
# current address actually is, so it survives a DHCP address change without
# anyone re-sharing a link. Change this only if two people on the same LAN
# both run this game at once and need to tell their rooms apart.
MDNS_NAME=ludo

# ─── Timings (milliseconds) ──────────────────────────────────────────────────
# How long an empty lobby seat is held before it's freed, if its owner
# disconnects before the game starts (a WiFi blip, a phone's address
# changing, a page refresh) — generous on purpose, since losing the whole
# room over a temporary drop before anyone's even started playing is a much
# worse outcome than a stale seat sitting around a few extra minutes.
LOBBY_RECONNECT_GRACE_MS=300000
# Once the game has actually started, a disconnected player is NEVER handed
# to AUTO automatically — the game just waits, however long it takes, for
# the real person to reconnect with the same room code. There is no
# equivalent "grace period" setting for this; it's simply indefinite.
# Pause between an AUTO roll and its move, so the turn is legible on screen.
AUTO_MOVE_DELAY_MS=1200
# A roll that leaves exactly one legal move plays itself after this pause,
# with a visible countdown, instead of making the player tap the one
# highlighted piece.
FORCED_MOVE_DELAY_MS=5000
# How long a "no legal move" roll stays on screen before the turn passes.
SKIP_NOTICE_MS=1400
# Idle rooms are swept from memory after this long.
ROOM_TTL_MS=7200000

# ─── Background music (optional) ─────────────────────────────────────────────
# Random rock/electric-guitar-style tracks from Jamendo's free, Creative-
# Commons-licensed catalog. Without this set, the game just runs silently —
# no error, nothing breaks. Get a free client id in minutes at
# https://devportal.jamendo.com (Sign up -> Create an application) and paste
# it below. Must be NEXT_PUBLIC_ (read in the browser, not the server), and
# the dev/prod server needs a restart after adding it.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=
